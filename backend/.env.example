# PostgreSQL connection (database: graapes_hr)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/graapes_hr?schema=public"

PORT=4000
NODE_ENV=development

# Frontend origin allowed by CORS (must match exactly, no trailing slash)
FRONTEND_ORIGIN=http://localhost:3000

# Session lifetime in hours
SESSION_TTL_HOURS=12

# Where uploaded documents are stored (outside the web root) and the per-file size limit
UPLOAD_DIR=./storage/documents
MAX_UPLOAD_MB=5

# Initial password given to seeded accounts. Change immediately after first login.
SEED_DEFAULT_PASSWORD=ChangeMe@12345

# Optional rate-limit overrides (requests per window). Defaults: production 10 logins/15min and 300 API calls/min per IP;
# development is relaxed so the smoke tests can run repeatedly.
# LOGIN_RATE_LIMIT=10
# API_RATE_LIMIT=300

# Number of proxies in front of the API. 1 = Render only, 2 = Vercel rewrite -> Render
TRUST_PROXY_HOPS=2
